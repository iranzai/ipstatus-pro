{
  "manifest_version": 3,
  "name": "ipstatuspro",
  "version": "0.3.0",
  "description": "查看当前浏览器出口 IP，并连接 ipstatuspro 网络与流媒体检测。",
  "permissions": ["proxy", "tabs"],
  "host_permissions": ["https://*/*", "http://127.0.0.1:8081/*", "http://localhost:8081/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://127.0.0.1:8081/streaming.html*",
        "http://localhost:8081/streaming.html*",
        "https://ipstatus.net/streaming*",
        "https://www.ipstatus.net/streaming*"
      ],
      "js": ["bridge.js"],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_title": "ipstatuspro",
    "default_popup": "popup.html",
    "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png"}
  },
  "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}
}
